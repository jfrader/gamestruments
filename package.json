{
  "name": "gamestruments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:runtime && vite build && npm run smoke",
    "build:runtime": "npm run build --workspace @gamestruments/runtime",
    "build:itch": "bash tools/package-itch-demo.sh",
    "build:public-docs": "node tools/package-public-docs.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/runtime-import-smoke.mjs",
    "parity:wasm": "node tests/wasm-parity.mjs",
    "wasm:build": "node tools/build-wasm.mjs",
    "wasm:verify": "node tools/build-wasm.mjs --verify-source",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
