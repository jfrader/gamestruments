# Toolchain for the GDExtension's web side modules (tools/build_web_extension.sh).
# EMSCRIPTEN_VERSION must match the Emscripten that built Godot's official web
# export templates (godotengine/build-containers Dockerfile.web, 4.7 branch).
# gdext's web support needs nightly Rust (-Zbuild-std); pin a dated nightly.
EMSCRIPTEN_VERSION=4.0.20
RUST_WEB_TOOLCHAIN=nightly-2026-10-07
